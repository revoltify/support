{
    "name": "revoltify/support",
    "description": "Core support utilities for Revoltify packages",
    "type": "library",
    "keywords": [
        "revoltify",
        "support"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Rasel Islam Rafi",
            "email": "rasel@revoltify.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.29.3",
        "phpstan/phpstan": "^2.2.2",
        "rector/rector": "^2.5.2"
    },
    "autoload": {
        "psr-4": {
            "Revoltify\\Support\\": "src/"
        }
    },
    "scripts": {
        "pint": "./vendor/bin/pint",
        "stan": "./vendor/bin/phpstan analyse",
        "baseline": "./vendor/bin/phpstan analyse --generate-baseline",
        "rector": "./vendor/bin/rector"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
